{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hivemind",
  "version": "1.0.0",
  "identifier": "dev.hivemind.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Hivemind",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/attachments/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A board for running AI coding agents across projects",
    "longDescription": "Hivemind runs coding agents such as Claude Code and OpenCode headless, one ticket per project at a time, and shows their work on a Kanban board.",
    "publisher": "Boris Brock",
    "copyright": "\u00a9 2026 Boris Brock",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
